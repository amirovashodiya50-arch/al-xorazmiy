                                    <td class="font-semibold">$200.00</td>
                                    <td><span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-rose-50 text-rose-600 dark:bg-rose-500/10 dark:text-rose-400">Bekor qilindi</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Recent Activity Feed (1 Col) -->
                <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 shadow-sm">
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-4">So'nggi Harakatlar</h3>
                    
                    <div class="space-y-4">
                        <div class="flex items-start space-x-3">
