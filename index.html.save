<!DOCTYPE html>
<html lang="uz" class="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zamonaviy Admin Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script>
        // Tailwind configuration for custom themes
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.4);
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(156, 163, 175, 0.7);
        }

        /* Smooth UI Transitions */
        * {
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }

        /* Glassmorphism effect for cards */
        .glass-card {
            backdrop-filter: blur(8px);
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 font-sans antialiased min-h-screen flex flex-col md:flex-row overflow-x-hidden">

    <!-- Mobile Header Navigation Toggle -->
    <div class="md:hidden flex items-center justify-between p-4 bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
        <div class="flex items-center space-x-3">
            <div class="w-9 h-9 rounded-xl bg-brand-600 flex items-center justify-center text-white font-bold text-lg shadow-md shadow-brand-500/20">
                A
            </div>
            <span class="font-bold text-lg text-slate-800 dark:text-white">ApexAdmin</span>
        </div>
        <button id="mobileMenuBtn" class="p-2 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg">
            <i class="fa-solid fa-bars text-xl"></i>
        </button>
    </div>

    <!-- Sidebar overlay for mobile -->
    <div id="sidebarOverlay" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-40 hidden md:hidden"></div>

    <!-- Sidebar Navigation -->
    <aside id="sidebar" class="fixed md:static inset-y-0 left-0 z-50 w-64 bg-white dark:bg-slate-800 border-r border-slate-200 dark:border-slate-700 transform -translate-x-full md:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col justify-between shrink-0">
        <div>
            <!-- Sidebar Header / Logo -->
            <div class="h-16 flex items-center px-6 border-b border-slate-100 dark:border-slate-700/50">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-brand-600 to-indigo-500 flex items-center justify-center text-white font-bold text-lg shadow-md shadow-brand-500/30">
                        <i class="fa-solid fa-chart-pie text-sm"></i>
                    </div>
                    <span class="font-bold text-xl tracking-tight bg-gradient-to-r from-slate-900 to-slate-700 dark:from-white dark:to-slate-300 bg-clip-text text-transparent">ApexAdmin</span>
                </div>
            </div>

            <div class="px-4 py-6 space-y-1">
                <p class="px-3 text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Asosiy Menyular</p>

                <a href="#" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400 font-medium">
                    <i class="fa-solid fa-house w-5 text-center"></i>
                    <span>Bosh Sahifa</span>
                </a>

                <a href="#" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50 hover:text-slate-900 dark:hover:text-white font-medium transition-colors">
                    <i class="fa-solid fa-chart-line w-5 text-center"></i>
                    <span>Analitika</span>

                </a>

                <a href="#" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50 hover:text-slate-900 dark:hover:text-white font-medium transition-colors">
                    <i class="fa-solid fa-cart-shopping w-5 text-center"></i>
                    <span>Buyurtmalar</span>
                    <span class="ml-auto bg-brand-100 dark:bg-brand-900/40 text-brand-600 dark:text-brand-300 text-xs font-semibold px-2 py-0.5 rounded-full">12</span>
                </a>

                <a href="#" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50 hover:text-slate-900 dark:hover:text-white font-medium transition-colors">
                    <i class="fa-solid fa-users w-5 text-center"></i>

                    <span>Mijozlar</span>
                </a>

                <p class="px-3 text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mt-6 mb-2">Boshqaruv</p>

                <a href="#" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50 hover:text-slate-900 dark:hover:text-white font-medium transition-colors">
                    <i class="fa-solid fa-box w-5 text-center"></i>
                    <span>Mahsulotlar</span>
                </a>


                <a href="#" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/50 hover:text-slate-900 dark:hover:text-white font-medium transition-colors">
                    <i class="fa-solid fa-gear w-5 text-center"></i>
                    <span>Sozlamalar</span>
                </a>

            </div>
        </div>

        <!-- Sidebar Footer Pro Promo Card -->
        <div class="p-4">
            <div class="p-4 rounded-2xl bg-gradient-to-br from-brand-600 to-indigo-700 text-white shadow-lg shadow-brand-500/20 relative overflow-hidden">
                <div class="absolute -right-4 -bottom-4 w-20 h-20 bg-white/10 rounded-full blur-xl"></div>
                <h4 class="font-semibold text-sm mb-1">Pro Tarifi</h4>
                <p class="text-xs text-brand-100 mb-3">Barcha imkoniyatlardan cheklovlarsiz foydalaning.</p>
                <button class="w-full py-1.5 px-3 bg-white text-brand-600 hover:bg-brand-50 rounded-lg text-xs font-semibold shadow transition-colors">
                    Yangilash
                </button>
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">

        <!-- Top Header Bar -->
        <header class="h-16 bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 px-4 md:px-8 flex items-center justify-between gap-4 sticky top-0 z-30">
            
            <!-- Global Search Input -->

            <div class="flex-1 max-w-md relative">
                <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                <input type="text" placeholder="Qidiruv (Ctrl + K)..." class="w-full pl-10 pr-4 py-2 rounded-xl bg-slate-100 dark:bg-slate-700/50 border border-transparent focus:border-brand-500 focus:bg-white dark:focus:bg-slate-900 text-sm outline-none transition-all">
            </div>

            <!-- Right Utilities Header Controls -->
            <div class="flex items-center space-x-3 shrink-0">
                
                <!-- Dark Mode Toggle Button -->
                <button id="themeToggleBtn" title="Mavzuni o'zgartirish" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600 flex items-center justify-center transition-colors">
                    <i class="fa-solid fa-moon dark:hidden"></i>
                    <i class="fa-solid fa-sun hidden dark:block"></i>
                </button>

                <!-- Notifications Button -->
                <div class="relative">
                    <button id="notifBtn" class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600 flex items-center justify-center transition-colors">
                        <i class="fa-regular fa-bell"></i>
                        <span class="absolute top-2 right-2 w-2 h-2 bg-rose-500 rounded-full animate-ping"></span>
                        <span class="absolute top-2 right-2 w-2 h-2 bg-rose-500 rounded-full"></span>
                    </button>

                </div>


                <div class="h-6 w-[1px] bg-slate-200 dark:bg-slate-700"></div>

                <!-- User Profile Dropdown Toggle -->

                <div class="flex items-center space-x-3 cursor-pointer group">
                    <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=150" alt="Foydalanuvchi rasmi" class="w-9 h-9 rounded-xl object-cover ring-2 ring-brand-500/20 group-hover:ring-brand-500 transition-all">
                    <div class="hidden sm:block text-left">

                        <div class="text-sm font-semibold leading-tight text-slate-800 dark:text-slate-100">Malika Aliyeva</div>
                        <div class="text-xs text-slate-400">Super Admin</div>
                    </div>
                </div>

            </div>
        </header>

        <!-- Main Dashboard View Container -->

        <main class="flex-1 overflow-y-auto p-4 md:p-8 space-y-6">

            <!-- Welcome Title Section -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Xush kelibsiz, Malika! 👋</h1>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Bugungi ko'rsatkichlar va analitikangiz tayyor.</p>
                </div>
                <div class="flex items-center space-x-3">
                    <button class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl text-sm font-medium hover:bg-slate-50 dark:hover:bg-slate-700 shadow-sm transition-colors">
                        <i class="fa-solid fa-calendar mr-2 text-slate-400"></i> Bugun
                    </button>
                    <button class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white rounded-xl text-sm font-medium shadow-lg shadow-brand-500/25 transition-all">
                        <i class="fa-solid fa-plus mr-2"></i> Hisobot Yaratish
                    </button>
                </div>
            </div>

            <!-- Key Metrics Cards (4 Stats) -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
                
                <!-- Stat Card 1 -->
                <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Jami Daromad</span>
                        <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                    </div>
                    <div class="text-2xl font-bold text-slate-900 dark:text-white mb-2">$45,231.89</div>
                    <div class="flex items-center text-xs font-semibold text-emerald-600 dark:text-emerald-400">
                        <i class="fa-solid fa-arrow-up mr-1"></i>
                        <span>+14.2%</span>
                        <span class="text-slate-400 font-normal ml-1.5">o'tgan oyga nisbatan</span>
                    </div>
                </div>

                <!-- Stat Card 2 -->
                <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Buyurtmalar</span>
                        <div class="w-10 h-10 rounded-xl bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400 flex items-center justify-center">
                            <i class="fa-solid fa-bag-shopping"></i>
                        </div>
                    </div>
                    <div class="text-2xl font-bold text-slate-900 dark:text-white mb-2">+1,342</div>
                    <div class="flex items-center text-xs font-semibold text-emerald-600 dark:text-emerald-400">
                        <i class="fa-solid fa-arrow-up mr-1"></i>
                        <span>+8.1%</span>
                        <span class="text-slate-400 font-normal ml-1.5">o'tgan haftaga nisbatan</span>
                    </div>
                </div>

                <!-- Stat Card 3 -->
                <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Yangi Mijozlar</span>
                        <div class="w-10 h-10 rounded-xl bg-purple-50 dark:bg-purple-500/10 text-purple-600 dark:text-purple-400 flex items-center justify-center">
                            <i class="fa-solid fa-user-plus"></i>
                        </div>
                    </div>
                    <div class="text-2xl font-bold text-slate-900 dark:text-white mb-2">892</div>
                    <div class="flex items-center text-xs font-semibold text-rose-600 dark:text-rose-400">
                        <i class="fa-solid fa-arrow-down mr-1"></i>
                        <span>-2.4%</span>
                        <span class="text-slate-400 font-normal ml-1.5">o'tgan oyga nisbatan</span>
                    </div>
                </div>

                <!-- Stat Card 4 -->
                <div class="p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 shadow-sm hover:shadow-md transition-shadow">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-sm font-medium text-slate-500 dark:text-slate-400">Konversiya</span>
                        <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center">
                            <i class="fa-solid fa-chart-pie"></i>
                        </div>
                    </div>
                    <div class="text-2xl font-bold text-slate-900 dark:text-white mb-2">3.42%</div>
                    <div class="flex items-center text-xs font-semibold text-emerald-600 dark:text-emerald-400">
                        <i class="fa-solid fa-arrow-up mr-1"></i>
                        <span>+1.2%</span>
                        <span class="text-slate-400 font-normal ml-1.5">o'tgan haftaga nisbatan</span>
                    </div>
                </div>

            </div>

            <!-- Charts Grid Section -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Line Chart: Sales Analytics (Takes 2 cols) -->
                <div class="lg:col-span-2 p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 shadow-sm">
                    <div class="flex items-center justify-between mb-6">
                        <div>
                            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Sotuv Dynamicasi</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Oylik tushum va xarajatlar tahlili</p>
                        </div>
                        <div class="flex items-center space-x-2">
                            <span class="flex items-center text-xs text-slate-500"><span class="w-3 h-3 rounded-full bg-brand-500 mr-1.5"></span> Daromad</span>
                            <span class="flex items-center text-xs text-slate-500 ml-3"><span class="w-3 h-3 rounded-full bg-slate-300 dark:bg-slate-600 mr-1.5"></span> Xarajat</span>
                        </div>
                    </div>
                    <div class="h-64 relative w-full">
                        <canvas id="lineChart" class="w-full h-full"></canvas>
                    </div>
                </div>

                <!-- Bar Chart: Visitor Stats (Takes 1 col) -->
                <div class="p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-6">
                            <div>
                                <h3 class="text-lg font-bold text-slate-900 dark:text-white">Tashriflar</h3>
                                <p class="text-xs text-slate-500 dark:text-slate-400">Haftalik tashrif buyuruvchilar</p>
                            </div>
                            <span class="text-xs font-semibold px-2 py-1 bg-brand-50 dark:bg-brand-500/10 text-brand-600 dark:text-brand-400 rounded-lg">Haftalik</span>
                        </div>
                        <div class="h-56 relative w-full">
                            <canvas id="barChart" class="w-full h-full"></canvas>
                        </div>
                    </div>
                    <div class="pt-4 border-t border-slate-100 dark:border-slate-700/50 flex justify-between text-xs text-slate-500">
                        <span>Eng yuqori: <b>Juma (8.4k)</b></span>
                        <span>O'rtacha: <b>5.2k/kun</b></span>
                    </div>
                </div>

            </div>

            <!-- Table & Recent Activity Split Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- Data Table Section (2 Cols) -->
                <div class="lg:col-span-2 p-6 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200/80 dark:border-slate-700/80 shadow-sm flex flex-col">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                        <div>
                            <h3 class="text-lg font-bold text-slate-900 dark:text-white">Oxirgi Buyurtmalar</h3>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Tranzaksiyalar va ularning holati</p>
                        </div>
                        <div class="flex items-center space-x-2">
                            <input type="text" id="tableSearch" placeholder="Tranzaksiyani izlash..." class="px-3 py-1.5 text-xs rounded-xl bg-slate-100 dark:bg-slate-700 border border-transparent focus:border-brand-500 outline-none">
                        </div>
                    </div>

                    <!-- Responsive Table -->
                    <div class="overflow-x-auto flex-1">
                        <table class="w-full text-left text-sm">
                            <thead>
                                <tr class="text-xs uppercase text-slate-400 border-b border-slate-100 dark:border-slate-700">
                                    <th class="pb-3 font-semibold">Mijoz</th>
                                    <th class="pb-3 font-semibold">Xizmat/Mahsulot</th>
                                    <th class="pb-3 font-semibold">Sana</th>
                                    <th class="pb-3 font-semibold">Summa</th>
                                    <th class="pb-3 font-semibold">Holat</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-700/50 text-slate-700 dark:text-slate-300">
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                    <td class="py-3.5 flex items-center space-x-3">
                                        <div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 font-semibold text-xs flex items-center justify-center">AA</div>
                                        <span class="font-medium text-slate-900 dark:text-white">Aziz Ahmedov</span>
                                    </td>
                                    <td>UI/UX Dizayn Kitob</td>
                                    <td class="text-xs text-slate-400">10 Noy, 2026</td>
                                    <td class="font-semibold">$120.00</td>
                                    <td><span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400">Bajarildi</span></td>
                                </tr>
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                    <td class="py-3.5 flex items-center space-x-3">
                                        <div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 font-semibold text-xs flex items-center justify-center">SK</div>
                                        <span class="font-medium text-slate-900 dark:text-white">Sardor Karimov</span>
                                    </td>
                                    <td>SaaS Obuna (Yillik)</td>
                                    <td class="text-xs text-slate-400">09 Noy, 2026</td>
                                    <td class="font-semibold">$350.00</td>
                                    <td><span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-600 dark:bg-amber-500/10 dark:text-amber-400">Kutilmoqda</span></td>
                                </tr>
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                    <td class="py-3.5 flex items-center space-x-3">
                                        <div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 font-semibold text-xs flex items-center justify-center">NR</div>
                                        <span class="font-medium text-slate-900 dark:text-white">Nigora Rahimova</span>
                                    </td>
                                    <td>Frontend Kursi</td>
                                    <td class="text-xs text-slate-400">08 Noy, 2026</td>
                                    <td class="font-semibold">$85.00</td>
                                    <td><span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-600 dark:bg-emerald-500/10 dark:text-emerald-400">Bajarildi</span></td>
                                </tr>
                                <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30">
                                    <td class="py-3.5 flex items-center space-x-3">
                                        <div class="w-8 h-8 rounded-full bg-slate-200 dark:bg-slate-700 font-semibold text-xs flex items-center justify-center">JT</div>
                                        <span class="font-medium text-slate-900 dark:text-white">Javohir Toshpulatov</span>
                                    </td>
