        </main>
    </div>

    <!-- Interactive Custom Charts JavaScript Canvas implementation -->
    <script>
        // --- Dark / Light Mode Switching logic ---
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const htmlElement = document.documentElement;

        themeToggleBtn.addEventListener('click', () => {
            if (htmlElement.classList.contains('dark')) {
                htmlElement.classList.remove('dark');
                localStorage.setItem('theme', 'light');
            } else {
                htmlElement.classList.add('dark');
                localStorage.setItem('theme', 'dark');
            }
            // Redraw charts to update text colors according to theme
            drawCharts();
        });

        // --- Mobile Sidebar Toggle Logic ---
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const sidebar = document.getElementById('sidebar');
        const sidebarOverlay = document.getElementById('sidebarOverlay');

        function toggleSidebar() {
            sidebar.classList.toggle('-translate-x-full');
            sidebarOverlay.classList.toggle('hidden');
        }

        mobileMenuBtn.addEventListener('click', toggleSidebar);
        sidebarOverlay.addEventListener('click', toggleSidebar);

        // --- Canvas Charts Render Engine (No external heavy dependencies) ---
        function drawLineChart() {
            const canvas = document.getElementById('lineChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            // Set scale resolution
            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * 2;
            canvas.height = rect.height * 2;
            ctx.scale(2, 2);

            const isDark = htmlElement.classList.contains('dark');
            const width = rect.width;
            const height = rect.height;
            const padding = 30;

            const data1 = [20, 45, 35, 60, 50, 85, 75, 95]; // Income
            const data2 = [10, 25, 20, 35, 30, 45, 40, 55]; // Expense
            const labels = ['Yan', 'Fev', 'Mar', 'Apr', 'May', 'Iyun', 'Iyul', 'Avg'];

            ctx.clearRect(0, 0, width, height);

            // Draw grid lines
            ctx.strokeStyle = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';
            ctx.lineWidth = 1;
            for (let i = 0; i < 4; i++) {
                const y = padding + (height - padding * 2) * (i / 3);
                ctx.beginPath();
                ctx.moveTo(padding, y);
                ctx.lineTo(width - padding, y);
                ctx.stroke();
            }

            // Draw X Labels
            ctx.fillStyle = isDark ? '#94a3b8' : '#64748b';
            ctx.font = '11px Inter, sans-serif';
            ctx.textAlign = 'center';
            const stepX = (width - padding * 2) / (data1.length - 1);
            labels.forEach((label, i) => {
                ctx.fillText(label, padding + i * stepX, height - 8);
            });

            // Function to draw line
            function drawPath(data, color, gradientColor) {
                const stepY = (height - padding * 2) / 100;
                
                ctx.beginPath();
                data.forEach((val, i) => {
                    const x = padding + i * stepX;
                    const y = height - padding - val * stepY;
                    if (i === 0) ctx.moveTo(x, y);
                    else ctx.lineTo(x, y);
                });

                // Line style
                ctx.strokeStyle = color;
                ctx.lineWidth = 3;
                ctx.stroke();

                // Gradient Fill under line
                const fillPath = new Path2D();
                data.forEach((val, i) => {
                    const x = padding + i * stepX;
                    const y = height - padding - val * stepY;
                    if (i === 0) fillPath.moveTo(x, y);
                    else fillPath.lineTo(x, y);
                });
                fillPath.lineTo(padding + (data.length - 1) * stepX, height - padding);
                fillPath.lineTo(padding, height - padding);
                fillPath.closePath();

                const gradient = ctx.createLinearGradient(0, padding, 0, height - padding);
                gradient.addColorStop(0, gradientColor);
                gradient.addColorStop(1, 'rgba(0,0,0,0)');
                ctx.fillStyle = gradient;
                ctx.fill(fillPath);
            }

            drawPath(data2, isDark ? '#475569' : '#cbd5e1', 'rgba(148, 163, 184, 0.2)');
            drawPath(data1, '#3b82f6', 'rgba(59, 130, 246, 0.25)');
        }

        function drawBarChart() {
            const canvas = document.getElementById('barChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');

            const rect = canvas.getBoundingClientRect();
            canvas.width = rect.width * 2;
            canvas.height = rect.height * 2;
            ctx.scale(2, 2);

            const isDark = htmlElement.classList.contains('dark');
            const width = rect.width;
            const height = rect.height;
            const padding = 25;

            const data = [40, 65, 50, 80, 95, 60, 45];
            const labels = ['Dush', 'Sesh', 'Chor', 'Pay', 'Jum', 'Shan', 'Yak'];

            ctx.clearRect(0, 0, width, height);

            const stepX = (width - padding * 2) / data.length;
            const barWidth = 18;
            const maxVal = 100;

            data.forEach((val, i) => {
                const x = padding + i * stepX + (stepX - barWidth) / 2;
                const barHeight = (val / maxVal) * (height - padding * 2);
                const y = height - padding - barHeight;

                // Draw bar background (track)
                ctx.fillStyle = isDark ? 'rgba(255,255,255,0.05)' : '#f1f5f9';
                ctx.beginPath();
                ctx.roundRect(x, padding, barWidth, height - padding * 2, 6);
                ctx.fill();

                // Draw active bar fill
                ctx.fillStyle = i === 4 ? '#3b82f6' : (isDark ? '#64748b' : '#94a3b8');
                ctx.beginPath();
                ctx.roundRect(x, y, barWidth, barHeight, 6);
                ctx.fill();

                // Label
                ctx.fillStyle = isDark ? '#94a3b8' : '#64748b';
                ctx.font = '11px Inter, sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(labels[i], x + barWidth / 2, height - 5);
            })
        function drawCharts() {
            drawLineChart();
            drawBarChart();
        }

        // Itialize charts on load and handle resize
        window.addEventListener('load', () => {
            drawCharts();
        });

        window.addEventListener('resize', () => {
            drawCharts();
        });
    </script>
</body>
</html>
